# 이 파일을 .env 로 복사한 뒤 값을 변경하세요. (.env 는 Git에서 제외됩니다)
#   (SQL Injection 디렉터리에서) cp example/dbms/mysql/.env.example example/dbms/mysql/.env
# 비밀번호 규칙: 12자 이상, 영문/숫자/_.@%+=:,- 만 사용 (init/03-users.sh 에서 검증)
# 아래 값은 로컬 예제 전용 자리표시자입니다. 운영 환경에서 사용하지 마세요.

# 호스트에 노출할 포트 (127.0.0.1 에만 바인딩됨)
MYSQL_PORT=3306

# 관리자 계정: 초기화/스키마 변경 전용. 애플리케이션에서 사용하지 않는다.
MYSQL_ROOT_PASSWORD=change-me-root-0001

# 프레임워크별 애플리케이션 계정({fw}_app) 비밀번호
SPRING_BOOT_DB_PASSWORD=change-me-spring-boot-0001
NESTJS_DB_PASSWORD=change-me-nestjs-0001
EXPRESS_DB_PASSWORD=change-me-express-0001
FASTAPI_DB_PASSWORD=change-me-fastapi-0001
DJANGO_DB_PASSWORD=change-me-django-0001

# SELECT 전용 계정({fw}_reader) 공통 비밀번호
READER_DB_PASSWORD=change-me-reader-0001
